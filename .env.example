# Marketing Assistant — environment variables
# Copy this file to .env and fill in real values when you're ready to connect to external services.
# Mock mode does NOT require any of these.

# X (Twitter) API credentials — needed for live mode only
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here
X_BEARER_TOKEN=your_x_bearer_token_here

# Anthropic API key — needed for AI-powered scoring and generation in live mode
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Active product profile (default: signal_shift)
PROFILE=signal_shift
