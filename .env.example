# Marketing Assistant — environment variables
# Copy this file to .env and fill in real values.
# Mock mode works without any of these — email is the only optional addition.

# ── Email delivery ────────────────────────────────────────────────────────────
# Set SEND_EMAIL=true to have Mel email the digest after generating it.
# Default is false — digest is saved locally only.
SEND_EMAIL=false

# Email provider (only resend is supported right now)
EMAIL_PROVIDER=resend

# Your Resend API key — get one at resend.com
RESEND_API_KEY=

# Sending address — must match a domain verified in your Resend account.
# For testing you can use: Mel <onboarding@resend.dev>
EMAIL_FROM=Mel <mel@yourdomain.com>

# Where the digest is delivered
EMAIL_TO=you@example.com

# ── Web search discovery — run_search.py (preferred: Tavily, no card required) ─
# Select provider: tavily (default, free) or brave (requires paid subscription)
SEARCH_PROVIDER=tavily

# Tavily Search API — free tier, no credit card. Sign up at app.tavily.com.
TAVILY_API_KEY=

# Brave Search API — requires a paid subscription before API keys are issued.
BRAVE_SEARCH_API_KEY=

# Number of search queries to run per session (default 5)
MAX_SEARCH_QUERIES=5

# Results to request per query (default 5)
MAX_RESULTS_PER_QUERY=5

# ── X (Twitter) API — live mode only, not needed yet ─────────────────────────
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# ── Anthropic API — live mode only, not needed yet ───────────────────────────
ANTHROPIC_API_KEY=

# ── Profile ───────────────────────────────────────────────────────────────────
PROFILE=signal_shift
